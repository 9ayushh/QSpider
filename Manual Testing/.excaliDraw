    {
      "id": "hke6UbOXoFI5KW_MhsNOd",
      "type": "text",
      "x": 1014.856927996871,
      "y": 2932.0365652393803,
      "width": 508.2796325683594,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "r2omxN7-TVRI3QyIAcnk3"
      ],
      "frameId": null,
      "index": "b2w",
      "roundness": null,
      "seed": 69345621,
      "version": 694,
      "versionNonce": 253954011,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787662083993,
      "link": null,
      "locked": false,
      "text": "Add user link:\n1. when user clicked on add users link, \nadd user page should be display.\n2. user name text field : it should accept 5-32 char\n3. pwd test field : it shoud accept min 6 char \n& include atleast 1 special char\n4. designation dropdown : it is mandatory\n5. emailid test field : it should accept valid \nmail id format\n6. mobile no : it should accept 10 digit no\n7. gender : it is mandatory\n8. D.O.B text field : it should accept valid\nd.o.b\n9. submit button : when clicked user should\nbe created\n10. cancel button : it should not create user",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Add user link:\n1. when user clicked on add users link, \nadd user page should be display.\n2. user name text field : it should accept 5-32 char\n3. pwd test field : it shoud accept min 6 char \n& include atleast 1 special char\n4. designation dropdown : it is mandatory\n5. emailid test field : it should accept valid \nmail id format\n6. mobile no : it should accept 10 digit no\n7. gender : it is mandatory\n8. D.O.B text field : it should accept valid\nd.o.b\n9. submit button : when clicked user should\nbe created\n10. cancel button : it should not create user",
      "autoResize": true,
      "lineHeight": 1.25
    },
